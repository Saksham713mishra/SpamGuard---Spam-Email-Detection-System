{
  "manifest_version": 3,
  "name": "SpamGuard Beta Scanner",
  "version": "0.1.0",
  "description": "Scan suspicious text and URLs using your local SpamGuard backend.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "SpamGuard Beta",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
